files:
  "/etc/nginx/conf.d/https_redirect.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # CORS 매핑 설정 - 테스트 환경용 오리진
      map $http_origin $cors_origin {
        default "";
        "https://goraekorean.site" "https://goraekorean.site";
        "https://www.goraekorean.site" "https://www.goraekorean.site";
        "https://dev-api.goraekorean.site" "https://dev-api.goraekorean.site";
      }

      # HTTP to HTTPS redirect
      server {
        listen 80;
        server_name dev-api.goraekorean.site;
        return 301 https://$server_name$request_uri;
      }

      # HTTPS server
      server {
        listen 443 ssl;
        server_name dev-api.goraekorean.site;

        # SSL 인증서 설정 (Certbot으로 생성된 인증서 경로)
        ssl_certificate /etc/letsencrypt/live/dev-api.goraekorean.site/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/dev-api.goraekorean.site/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;

        location / {
          proxy_pass http://docker;
          proxy_http_version 1.1;
        }
      }

container_commands:
  01_reload_nginx:
    command: "sudo service nginx reload"